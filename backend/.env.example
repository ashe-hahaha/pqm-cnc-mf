HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001"]
# mock | http | database (database adapter is reserved, not implemented)
DATA_SOURCE=mock
# HTTP mode: GET {UPSTREAM_BASE_URL}/api/hierarchy
UPSTREAM_BASE_URL=
UPSTREAM_API_TOKEN=
UPSTREAM_TIMEOUT_SECONDS=10

# Signal datasource (independent of hierarchy DATA_SOURCE)
SIGNALS_WS_URL=ws://172.20.114.237:4000/ws
SIGNALS_MACHINE_ID=Makino_01
SIGNALS_POLL_SECONDS=1
SIGNALS_WINDOW_MS=10000
SIGNALS_STALE_SECONDS=10

# Tool wear history DB (independent of DATA_SOURCE and signal WS)
# Fill URL + table, then install the matching driver (see README).
# PostgreSQL: postgresql+psycopg://readonly:password@SERVER:5432/DATABASE
# MySQL: mysql+pymysql://readonly:password@SERVER:3306/DATABASE
# ClickHouse HTTP: clickhousedb://readonly:password@SERVER:8123/DATABASE
TOOL_WEAR_DB_URL=
# Driver-specific connection/statement timeouts, JSON object (see README)
TOOL_WEAR_DB_OPTIONS={}
TOOL_WEAR_TABLE=
# Optional SQL schema; for ClickHouse, put database in the URL.
TOOL_WEAR_SCHEMA=
# Required column mappings. Timestamps must be UTC; wear/geometry must be mm.
TOOL_WEAR_TIME_COLUMN=timestamp
TOOL_WEAR_MACHINE_COLUMN=machine_id
TOOL_WEAR_TOOL_COLUMN=tool_no
TOOL_WEAR_X_COLUMN=xWearMm
TOOL_WEAR_Z_COLUMN=zWearMm
# integer: request tool_no=6; string: exact database value, e.g. T06
TOOL_WEAR_TOOL_TYPE=integer
# Optional columns: leave empty if unavailable. Missing values return null.
TOOL_WEAR_X_GEOMETRY_COLUMN=
TOOL_WEAR_Z_GEOMETRY_COLUMN=
# Optional tool instance/change batch to distinguish replacements in the same slot
TOOL_WEAR_INSTANCE_COLUMN=
TOOL_WEAR_MAX_RANGE_HOURS=168
TOOL_WEAR_MAX_POINTS=2000

# Wear trend data source. HTTP is the default; database keeps the optional direct SQL adapter.
TOOL_WEAR_HISTORY_SOURCE=http
HISTORY_BASE_URL=http://172.20.114.237:4000
HISTORY_ENVIRONMENT=real
HISTORY_TIMEOUT_SECONDS=20

# Microscope image receiver. Enable to consume new captures independent of frontend.
MICROSCOPE_KAFKA_ENABLED=true
MICROSCOPE_KAFKA_BOOTSTRAP_SERVERS=172.20.114.237:9094
MICROSCOPE_KAFKA_TOPIC=makino_microscope_image
MICROSCOPE_KAFKA_GROUP_ID=pqm-cnc-microscope
MICROSCOPE_KAFKA_CLIENT_ID=pqm-cnc-backend
# Only applies if this group has no committed offset: latest | earliest
MICROSCOPE_KAFKA_AUTO_OFFSET_RESET=latest
# Kafka JSON message limit and decoded image limit are separate.
MICROSCOPE_KAFKA_MAX_MESSAGE_BYTES=50000000
MICROSCOPE_MAX_IMAGE_BYTES=50000000
MICROSCOPE_IMAGE_DIR=./data/microscope

# Mock prediction controls and alert delivery
TOOL_WEAR_DEMO_ENABLED=false
TOOL_WEAR_ALERT_KAFKA_ENABLED=false
TOOL_WEAR_ALERT_KAFKA_TOPIC=makino_tool_wear_alert
TOOL_WEAR_ALERT_TEMI_ENABLED=false
TOOL_WEAR_ALERT_TEMI_URL=
TOOL_WEAR_ALERT_TEMI_TOKEN=
