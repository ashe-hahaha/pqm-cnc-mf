# Browser-accessible backend URL. Use HTTPS for an HTTPS frontend.
NEXT_PUBLIC_DATA_API_URL=http://127.0.0.1:8000
# Optional: backend default is used when omitted.
NEXT_PUBLIC_SIGNALS_MACHINE_ID=Makino_01
